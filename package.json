{
  "name": "alkaidlab-foundation-sunshine",
  "private": true,
  "engines": {
    "node": ">=26.7.0 <27",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@firebase/util": false,
    "protobufjs": false
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/run-webui.mjs build:webui",
    "build-clean": "node scripts/run-webui.mjs build:webui",
    "build:debug": "node scripts/run-webui.mjs build:webui --debug",
    "dev": "node scripts/run-webui.mjs build:webui --watch",
    "dev-server": "node scripts/run-webui.mjs dev:webui",
    "preview": "node scripts/run-webui.mjs preview:webui",
    "preview:build": "npm run build && npm run preview",
    "lint:webui": "node scripts/run-webui.mjs lint:webui",
    "test:webui": "node scripts/run-webui.mjs test:webui",
    "i18n:validate": "node scripts/validate-i18n.js",
    "i18n:sync": "node scripts/validate-i18n.js --sync",
    "i18n:reverse-sync": "node scripts/reverse-sync-i18n.js --sync",
    "i18n:reverse-check": "node scripts/reverse-sync-i18n.js",
    "i18n:format": "node scripts/format-i18n.js",
    "i18n:format:check": "node scripts/format-i18n.js --check"
  }
}
