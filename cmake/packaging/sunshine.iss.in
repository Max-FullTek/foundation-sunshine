[Types]
Name: "recommended"; Description: "{cm:TypeRecommended}"
Name: "full"; Description: "{cm:TypeFull}"
Name: "compact"; Description: "{cm:TypeCompact}"
Name: "custom"; Description: "{cm:TypeCustom}"; Flags: iscustom

[Components]
Name: "application"; Description: "{cm:ComponentApplication}"; Types: recommended full compact custom; Flags: fixed
Name: "assets"; Description: "{cm:ComponentAssets}"; Types: recommended full compact custom; Flags: fixed
Name: "gui"; Description: "{cm:ComponentGUI}"; Types: recommended full compact custom; Flags: fixed
Name: "vdd"; Description: "{cm:ComponentVDD} — {cm:ComponentVDDDesc}"; Types: full; ExtraDiskSpaceRequired: 2097152
Name: "firewall"; Description: "{cm:ComponentFirewall} — {cm:ComponentFirewallDesc}"; Types: recommended full compact
Name: "autostart"; Description: "{cm:ComponentAutostart} — {cm:ComponentAutostartDesc}"; Types: recommended full
Name: "gamepad"; Description: "{cm:ComponentGamepad} — {cm:ComponentGamepadDesc}"; Types: full
Name: "vmouse"; Description: "{cm:ComponentVmouse} — {cm:ComponentVmouseDesc}"
Name: "tools"; Description: "{cm:ComponentTools} — {cm:ComponentToolsDesc}"; Types: recommended full

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[InstallDelete]
; Remove old hashed Web UI bundles before installing the freshly built frontend.
Type: filesandordirs; Name: "{app}\assets\web"
; The native GUI plugin replaces the legacy standalone diagnostic executable.
Type: files; Name: "{app}\tools\stylus-input-probe.exe"
; Earlier RTX adapter builds placed the complete VC runtime beside Sunshine.
Type: files; Name: "{app}\msvcp140*.dll"
Type: files; Name: "{app}\vcruntime140*.dll"
Type: files; Name: "{app}\concrt140.dll"

[Files]
; Main application
Source: "{#MySourceDir}\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\zlib1.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: application

; Mandatory tools
Source: "{#MySourceDir}\tools\sunshinesvc.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\tools\qiin-tabtip.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\tools\nefconw.exe"; DestDir: "{app}\tools"; Flags: ignoreversion; Components: application

; Pinned manifest for the separately distributed first-party DualSense runtime.

; Optional SDR/HDR virtual display adapter. List first-party files explicitly
; so a stale local staging directory cannot add a vendor runtime to the package.
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\foundation_rtx_video_adapter.dll"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\README.md"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_rtx_video\RTX_VIDEO_THIRD_PARTY_NOTICES.md"; DestDir: "{app}\tools\hdr_enhanced\nvidia_rtx_video"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
; Optional DLSS NR adapter: first-party only, the NVIDIA runtime is never packaged.
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\foundation_dlssnr_adapter.dll"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\NVIDIA-DLSS-LICENSE.txt"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application
Source: "{#MySourceDir}\tools\hdr_enhanced\nvidia_dlssnr\NVIDIA-OPTICAL-FLOW-NOTICES.txt"; DestDir: "{app}\tools\hdr_enhanced\nvidia_dlssnr"; Flags: ignoreversion skipifsourcedoesntexist; Components: application

; Portable scripts (will be deleted during install, but needed for layout)
Source: "{#MySourceDir}\install_portable.bat"; DestDir: "{app}"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\uninstall_portable.bat"; DestDir: "{app}"; Flags: ignoreversion; Components: application

; Language files
Source: "{#MySourceDir}\scripts\languages\*"; DestDir: "{app}\scripts\languages"; Flags: ignoreversion recursesubdirs; Components: application

; Service scripts
Source: "{#MySourceDir}\scripts\install-service.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\uninstall-service.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\sleep.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

; Migration scripts
Source: "{#MySourceDir}\scripts\migrate-config.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\migrate-images.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application
Source: "{#MySourceDir}\scripts\IMAGE_MIGRATION.md"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

; PATH management
Source: "{#MySourceDir}\scripts\update-path.bat"; DestDir: "{app}\scripts"; Flags: ignoreversion; Components: application

